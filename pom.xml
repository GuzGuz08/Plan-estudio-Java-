<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot como proyecto padre (nos da configuraciones por defecto) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.2</version>
    </parent>

    <!-- Datos de NUESTRO proyecto -->
    <groupId>com.ceiba</groupId>
    <artifactId>hola-mundo</artifactId>
    <version>1.0.0</version>
    <name>hola-mundo</name>
    <description>Mi primer proyecto Spring Boot - Plan de Entrenamiento</description>

    <!-- Version de Java que usamos -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Dependencias (librerias que necesitamos) -->
    <dependencies>
        <!-- Esta dependencia nos da todo para crear APIs REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <!-- Plugin para ejecutar la app con: mvn spring-boot:run -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
